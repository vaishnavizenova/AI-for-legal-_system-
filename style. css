    font-size: 8px;

    line-height: 1.5;

    color: #444444;

    max-width: 175px;

    margin: 0 auto;
}



/* =========================================
   PROCESS SECTION
========================================= */

.process-section {
    width: 100%;

    background: #ffffff;

    padding: 3px 34px 32px;
}

.process-container {
    width: 100%;

    max-width: 1310px;

    margin: 0 auto;
}



/* =========================================
   PROCESS HEADING
========================================= */

.process-heading {
    margin-bottom: 17px;
}



/* =========================================
   PROCESS TIMELINE
========================================= */

.process-timeline {
    position: relative;

    width: 100%;

    display: grid;

    grid-template-columns:
        repeat(5, 1fr);

    gap: 20px;

    padding: 0 28px;
}



/* Connecting line */

.process-line {
    position: absolute;

    height: 1px;

    background: #cfcfcf;

    left: 10%;

    right: 10%;

    top: 26px;

    z-index: 0;
}



/* =========================================
   PROCESS STEP
========================================= */

.process-step {
    position: relative;

    z-index: 1;

    text-align: center;

    display: flex;

    flex-direction: column;

    align-items: center;
}



/* =========================================
   PROCESS ICON
========================================= */

.process-icon {
    width: 52px;
    height: 52px;

    border: 1px solid #dddddd;

    border-radius: 50%;

    background: #ffffff;

    display: flex;

    align-items: center;
    justify-content: center;

    margin-bottom: 7px;
}



/* =========================================
   UNDERSTAND ICON
========================================= */

.understand-icon {
    position: relative;

    width: 25px;
    height: 25px;
}

.understand-circle {
    position: absolute;

    width: 16px;
    height: 16px;

    border: 1.5px solid #333333;

    border-radius: 50%;

    left: 5px;
    top: 5px;
}

.understand-hand {
    position: absolute;

    width: 10px;
    height: 7px;

    border-left: 1.5px solid #333333;
    border-bottom: 1.5px solid #333333;

    left: 8px;
    top: 10px;

    transform: rotate(-35deg);
}



/* =========================================
   PLAN ICON
========================================= */

.plan-icon {
    position: relative;

    width: 24px;
    height: 26px;
}

.plan-box {
    position: absolute;

    width: 20px;
    height: 19px;

    border: 1.5px solid #333333;

    border-radius: 3px;

    left: 2px;
    bottom: 0;
}

.plan-handle {
    position: absolute;

    width: 8px;
    height: 6px;

    border: 1.5px solid #333333;

    border-bottom: none;

    border-radius: 3px 3px 0 0;

    left: 8px;
    top: 1px;
}



/* =========================================
   BUILD ICON
========================================= */

.build-icon {
    width: 26px;
    height: 24px;
}

.build-window {
    width: 25px;
    height: 20px;

    border: 1.5px solid #333333;

    border-radius: 3px;

    display: flex;

    align-items: center;
    justify-content: center;
}

.build-window span {
    font-size: 9px;

    font-weight: 700;

    color: #333333;
}



/* =========================================
   TEST ICON
========================================= */

.test-icon {
    width: 25px;
    height: 25px;

    display: flex;

    align-items: center;
    justify-content: center;
}

.test-circle {
    width: 21px;
    height: 21px;

    border: 1.5px solid #333333;

    border-radius: 50%;

    display: flex;

    align-items: center;
    justify-content: center;

    font-size: 10px;

    font-weight: 700;
}



/* =========================================
   LAUNCH ICON
========================================= */

.launch-icon {
    position: relative;

    width: 27px;
    height: 27px;

    transform: rotate(-30deg);
}

.launch-rocket {
    position: absolute;

    width: 10px;
    height: 21px;

    border: 1.5px solid #333333;

    border-radius: 50%;

    left: 9px;
    top: 1px;
}

.launch-window {
    position: absolute;

    width: 4px;
    height: 4px;

    border: 1px solid #333333;

    border-radius: 50%;

    left: 12px;
    top: 6px;
}



/* =========================================
   PROCESS TEXT
========================================= */

.process-number {
    font-size: 7px;

    line-height: 1;

    font-weight: 600;

    color: #444444;

    margin-bottom: 3px;
}

.process-step h3 {
    font-size: 10px;

    line-height: 1.2;

    font-weight: 700;

    margin-bottom: 5px;
}

.process-step p {
    max-width: 135px;

    font-size: 7.5px;

    line-height: 1.45;

    color: #444444;
}



/* =========================================
   PART 4 RESPONSIVE
========================================= */

@media (max-width: 900px) {

    .why-us-grid {
        grid-template-columns:
            repeat(3, 1fr);

        row-gap: 25px;
    }

    .process-timeline {
        gap: 10px;

        padding: 0 10px;
    }

}



@media (max-width: 650px) {

    .why-us-section,
    .process-section {
        padding-left: 18px;
        padding-right: 18px;
    }

    .why-us-grid {
        grid-template-columns:
            repeat(2, 1fr);

        row-gap: 28px;
    }

    .process-timeline {
        grid-template-columns: 1fr;

        gap: 20px;

        padding: 0;
    }

    .process-line {
        width: 1px;

        height: calc(100% - 52px);

        left: 50%;

        right: auto;

        top: 26px;
    }

    .process-step {
        background: #ffffff;
    }

}
/* =========================================
   PART 5
   FINAL CTA + FOOTER
========================================= */


/* =========================================
   FINAL CTA SECTION
========================================= */

.final-cta-section {
    width: 100%;

    background: #ffffff;

    padding: 8px 34px 22px;
}

.final-cta-container {
    width: 100%;

    max-width: 1310px;

    min-height: 190px;

    margin: 0 auto;

    background: #171717;

    border-radius: 7px;

    padding: 24px 55px;

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 55px;

    color: #ffffff;

    overflow: hidden;

    position: relative;
}



/* =========================================
   CTA DECORATIVE ELEMENT
========================================= */

.cta-legal-icon {
    width: 150px;
    height: 125px;

    position: relative;

    display: flex;

    align-items: center;

    justify-content: center;

    opacity: 0.95;
}

.cta-scale {
    position: relative;

    width: 110px;
    height: 110px;
}



/* Scale top */

.cta-scale-top {
    position: absolute;

    width: 9px;
    height: 9px;

    background: #ffffff;

    border-radius: 50%;

    top: 1px;
    left: 50px;
}

.cta-scale-top::after {
    content: "";

    position: absolute;

    width: 4px;
    height: 19px;

    background: #ffffff;

    left: 2.5px;
    top: 8px;
}



/* Scale column */

.cta-scale-column {
    position: absolute;

    width: 5px;
    height: 66px;

    background: #ffffff;

    left: 52px;
    top: 19px;

    border-radius: 4px;
}



/* Scale arms */

.cta-scale-arm {
    position: absolute;

    width: 54px;
    height: 35px;

    top: 32px;
}

.cta-left-arm {
    left: 0;

    transform: rotate(8deg);
}

.cta-right-arm {
    right: 0;

    transform: rotate(-8deg);
}

.cta-scale-arm span {
    position: absolute;

    width: 54px;
    height: 3px;

    background: #ffffff;

    border-radius: 50%;

    top: 0;
}

.cta-scale-arm i {
    position: absolute;

    width: 1px;
    height: 30px;

    background: #ffffff;

    top: 4px;
}

.cta-left-arm i {
    left: 5px;
}

.cta-right-arm i {
    right: 5px;
}

.cta-scale-arm i::after {
    content: "";

    position: absolute;

    width: 30px;
    height: 6px;

    border-bottom: 2px solid #ffffff;

    border-radius: 50%;

    top: 28px;

    left: -14px;
}



/* Scale base */

.cta-scale-base {
    position: absolute;

    width: 60px;
    height: 7px;

    background: #ffffff;

    border-radius: 3px;

    left: 25px;
    bottom: 12px;
}

.cta-scale-base::after {
    content: "";

    position: absolute;

    width: 76px;
    height: 5px;

    background: #ffffff;

    border-radius: 3px;

    left: -8px;
    bottom: -6px;
}



/* =========================================
   CTA CONTENT
========================================= */

.final-cta-content {
    text-align: left;

    max-width: 570px;
}

.cta-label {
    display: block;

    font-size: 7px;

    line-height: 1;

    letter-spacing: 1.8px;

    font-weight: 700;

    color: #bdbdbd;

    margin-bottom: 7px;
}

.final-cta-content h2 {
    font-size: 25px;

    line-height: 1.15;

    letter-spacing: -0.8px;

    font-weight: 700;

    margin-bottom: 7px;
}

.final-cta-content p {
    max-width: 430px;

    font-size: 9px;

    line-height: 1.5;

    color: #cccccc;

    margin-bottom: 13px;
}



/* =========================================
   CTA BUTTONS
========================================= */

.cta-buttons {
    display: flex;

    align-items: center;

    gap: 8px;
}

.cta-primary-button,
.cta-secondary-button {
    height: 29px;

    padding: 0 14px;

    display: inline-flex;

    align-items: center;
    justify-content: center;

    border-radius: 3px;

    font-size: 8px;

    font-weight: 600;
}

.cta-primary-button {
    background: #ffffff;

    color: #111111;

    border: 1px solid #ffffff;
}

.cta-secondary-button {
    background: transparent;

    color: #ffffff;

    border: 1px solid #777777;
}



/* =========================================
   FOOTER
========================================= */

.site-footer {
    width: 100%;

    background: #ffffff;

    border-top: 1px solid #e7e7e7;
}

.footer-container {
    width: 100%;

    max-width: 1310px;

    margin: 0 auto;

    padding: 25px 34px 23px;

    display: grid;

    grid-template-columns:
        2.2fr
        1fr
        1.25fr
        1.45fr
        0.9fr;

    gap: 30px;
}



/* =========================================
   FOOTER BRAND
========================================= */

.footer-brand {
    display: inline-flex;

    align-items: center;

    gap: 8px;

    margin-bottom: 9px;
}

.footer-brand span {
    font-size: 12px;

    font-weight: 700;

    letter-spacing: -0.2px;
}



/* Footer logo */

.footer-brand-icon {
    position: relative;

    width: 25px;
    height: 25px;
}

.footer-scale-beam {
    position: absolute;

    width: 20px;
    height: 1.5px;

    background: #222222;

    top: 6px;
    left: 2px;
}

.footer-scale-stand {
    position: absolute;

    width: 1.5px;
    height: 18px;

    background: #222222;

    left: 12px;
    top: 6px;
}

.footer-scale-left,
.footer-scale-right {
    position: absolute;

    width: 8px;
    height: 6px;

    border-bottom: 1.5px solid #222222;

    top: 8px;
}

.footer-scale-left {
    left: -1px;
}

.footer-scale-right {
    right: -1px;
}

.footer-scale-left::before,
.footer-scale-right::before {
    content: "";

    position: absolute;

    width: 1px;
    height: 6px;

    background: #222222;

    top: -5px;
}

.footer-scale-left::before {
    left: 0;
}

.footer-scale-right::before {
    right: 0;
}



/* =========================================
   FOOTER DESCRIPTION
========================================= */

.footer-description {
    max-width: 245px;

    font-size: 8px;

    line-height: 1.55;

    color: #555555;

    margin-bottom: 13px;
}



/* =========================================
   SOCIAL ICONS
========================================= */

.footer-socials {
    display: flex;

    align-items: center;

    gap: 6px;
}

.footer-socials a {
    width: 22px;
    height: 22px;

    border: 1px solid #d8d8d8;

    border-radius: 50%;

    display: flex;

    align-items: center;
    justify-content: center;

    font-size: 8px;

    font-weight: 700;

    color: #333333;
}

.footer-socials a:hover {
    background: #111111;

    color: #ffffff;

    border-color: #111111;
}



/* =========================================
   FOOTER COLUMNS
========================================= */

.footer-column h3 {
    font-size: 9px;

    line-height: 1.2;

    font-weight: 700;

    margin-bottom: 10px;
}

.footer-column ul {
    list-style: none;

    display: flex;

    flex-direction: column;

    gap: 7px;
}

.footer-column li,
.footer-column a {
    font-size: 8px;

    line-height: 1.3;

    color: #555555;
}

.footer-column a:hover {
    color: #111111;
}



/* =========================================
   CONTACT COLUMN
========================================= */

.contact-column ul {
    gap: 9px;
}

.contact-column li {
    display: flex;

    align-items: flex-start;

    gap: 6px;
}

.contact-icon {
    width: 13px;

    min-width: 13px;

    font-size: 8px;

    font-weight: 700;

    color: #333333;

    text-align: center;
}



/* =========================================
   FOOTER BOTTOM
========================================= */

.footer-bottom {
    width: 100%;

    border-top: 1px solid #eeeeee;
}

.footer-bottom-container {
    width: 100%;

    max-width: 1310px;

    margin: 0 auto;

    padding: 10px 34px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 20px;
}

.footer-bottom p {
    font-size: 7px;

    line-height: 1.4;

    color: #777777;
}



/* =========================================
   PART 5 RESPONSIVE
========================================= */

@media (max-width: 950px) {

    .final-cta-container {
        gap: 25px;

        padding-left: 35px;
        padding-right: 35px;
    }

    .footer-container {
        grid-template-columns:
            2fr 1fr 1fr;

        row-gap: 25px;
    }

    .footer-brand-column {
        grid-column: span 3;
    }

}



@media (max-width: 650px) {

    .final-cta-section {
        padding-left: 18px;
        padding-right: 18px;
    }

    .final-cta-container {
        min-height: auto;

        padding: 30px 20px;

        flex-direction: column;

        gap: 10px;

        text-align: center;
    }

    .cta-legal-icon {
        width: 100px;
        height: 85px;

        transform: scale(0.8);
    }

    .final-cta-content {
        text-align: center;
    }

    .final-cta-content h2 {
        font-size: 22px;
    }

    .final-cta-content p {
        margin-left: auto;
        margin-right: auto;
    }

    .cta-buttons {
        justify-content: center;

        flex-wrap: wrap;
    }

    .footer-container {
        grid-template-columns: 1fr 1fr;

        padding-left: 18px;
        padding-right: 18px;
    }

    .footer-brand-column {
        grid-column: span 2;
    }

    .footer-bottom-container {
        padding-left: 18px;
        padding-right: 18px;

        flex-direction: column;

        align-items: flex-start;

        gap: 5px;
    }

}



@media (max-width: 400px) {

    .footer-container {
        grid-template-columns: 1fr;
    }

    .footer-brand-column {
        grid-column: span 1;
    }

}
