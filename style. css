/* =========================================
   GLOBAL RESET
========================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #ffffff;
    color: #111111;
}

a {
    text-decoration: none;
    color: inherit;
}



/* =========================================
   HEADER
========================================= */

.site-header {
    width: 100%;
    height: 70px;
    background: #ffffff;
    border-bottom: 1px solid #eeeeee;
}

.header-container {
    width: 100%;
    max-width: 1380px;
    height: 100%;
    margin: 0 auto;

    padding: 0 42px;

    display: flex;
    align-items: center;
    justify-content: space-between;
}



/* =========================================
   BRAND
========================================= */

.brand {
    display: flex;
    align-items: center;
    gap: 10px;

    white-space: nowrap;
}

.brand-name {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.2px;
}



/* =========================================
   SIMPLE SCALE LOGO
========================================= */

.brand-icon {
    position: relative;

    width: 30px;
    height: 30px;
}

.scale-beam {
    position: absolute;

    width: 23px;
    height: 2px;

    background: #111111;

    top: 7px;
    left: 3px;
}

.scale-stand {
    position: absolute;

    width: 2px;
    height: 21px;

    background: #111111;

    left: 14px;
    top: 7px;
}

.scale-stand::after {
    content: "";

    position: absolute;

    width: 11px;
    height: 2px;

    background: #111111;

    bottom: -1px;
    left: -4px;
}

.scale-left,
.scale-right {
    position: absolute;

    width: 10px;
    height: 7px;

    border-bottom: 2px solid #111111;

    top: 9px;
}

.scale-left {
    left: -1px;
}

.scale-right {
    right: -1px;
}

.scale-left::before,
.scale-right::before {
    content: "";

    position: absolute;

    width: 1px;
    height: 7px;

    background: #111111;

    top: -6px;
}

.scale-left::before {
    left: 0;
}

.scale-right::before {
    right: 0;
}



/* =========================================
   NAVIGATION
========================================= */

.main-navigation {
    display: flex;
    align-items: center;
    gap: 27px;

    margin-left: auto;
    margin-right: 40px;
}

.main-navigation a {
    font-size: 11px;
    font-weight: 500;

    color: #222222;

    transition: opacity 0.2s ease;
}

.main-navigation a:hover {
    opacity: 0.55;
}



/* =========================================
   HEADER BUTTON
========================================= */

.header-button {
    display: flex;
    align-items: center;
    justify-content: center;

    height: 34px;
    padding: 0 18px;

    background: #111111;
    color: #ffffff;

    border-radius: 5px;

    font-size: 11px;
    font-weight: 600;
}



/* =========================================
   HERO SECTION
========================================= */

.hero-section {
    width: 100%;
    background: #ffffff;
}

.hero-container {
    width: 100%;
    max-width: 1380px;

    min-height: 425px;

    margin: 0 auto;

    padding: 40px 55px 35px;

    display: grid;
    grid-template-columns: 43% 57%;
    align-items: center;
}



/* =========================================
   HERO CONTENT
========================================= */

.hero-content {
    padding-top: 4px;
}

.hero-content h1 {
    font-size: 34px;
    line-height: 1.12;

    letter-spacing: -1.3px;

    font-weight: 700;

    margin-bottom: 14px;
}

.hero-description {
    max-width: 385px;

    font-size: 12px;
    line-height: 1.65;

    color: #303030;

    margin-bottom: 19px;
}



/* =========================================
   HERO BUTTONS
========================================= */

.hero-buttons {
    display: flex;
    align-items: center;

    gap: 11px;

    margin-bottom: 22px;
}

.primary-button,
.secondary-button {
    height: 34px;

    padding: 0 17px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    border-radius: 4px;

    font-size: 11px;
    font-weight: 600;
}

.primary-button {
    background: #111111;
    color: #ffffff;

    border: 1px solid #111111;
}

.secondary-button {
    background: #ffffff;
    color: #111111;

    border: 1px solid #777777;
}



/* =========================================
   TRUST MESSAGE
========================================= */

.hero-trust {
    display: flex;
    align-items: center;

    gap: 10px;
}

.trust-icon {
    width: 23px;
    height: 27px;

    display: flex;
    align-items: center;
    justify-content: center;
}

.shield-shape {
    width: 19px;
    height: 22px;

    border: 1.5px solid #333333;

    clip-path: polygon(
        50% 0%,
        94% 16%,
        88% 63%,
        70% 86%,
        50% 100%,
        30% 86%,
        12% 63%,
        6% 16%
    );

    font-size: 10px;

    display: flex;
    align-items: center;
    justify-content: center;
}

.hero-trust p {
    font-size: 9px;
    line-height: 1.55;

    color: #444444;
}



/* =========================================
   HERO VISUAL
========================================= */

.hero-visual {
    position: relative;

    height: 350px;
    width: 100%;

    overflow: hidden;
}



/* =========================================
   FLOATING DOCUMENTS
========================================= */

.floating-document {
    position: absolute;

    width: 27px;
    height: 34px;

    border: 1px solid #d7d7d7;

    border-radius: 2px;

    background: rgba(255, 255, 255, 0.9);
}

.floating-document::before {
    content: "";

    position: absolute;

    top: 5px;
    right: 5px;

    width: 7px;
    height: 7px;

    border-top: 1px solid #cfcfcf;
    border-right: 1px solid #cfcfcf;
}

.document-one {
    top: 34px;
    right: 103px;
}

.document-two {
    top: 68px;
    right: 35px;
}

.document-three {
    top: 134px;
    right: 11px;
}

.document-lines {
    width: 13px;
    height: 1px;

    background: #d2d2d2;

    margin-left: 6px;
    margin-top: 14px;
}

.document-lines.short {
    width: 9px;

    margin-top: 4px;
}

.document-lines + .document-lines {
    margin-top: 4px;
}



/* =========================================
   CONNECTION LINES
========================================= */

.connection-line {
    position: absolute;

    height: 1px;

    background: #e4e4e4;

    transform-origin: left center;
}

.line-one {
    width: 95px;

    top: 80px;
    right: 118px;

    transform: rotate(8deg);
}

.line-two {
    width: 76px;

    top: 117px;
    right: 42px;

    transform: rotate(65deg);
}

.line-three {
    width: 68px;

    top: 153px;
    right: 44px;

    transform: rotate(-15deg);
}



/* =========================================
   LEGAL SCALE
========================================= */

.legal-scale {
    position: absolute;

    width: 180px;
    height: 230px;

    left: 100px;
    top: 48px;
}



/* Top ornament */
.scale-top {
    position: absolute;

    width: 10px;
    height: 10px;

    background: #1a1a1a;

    border-radius: 50%;

    left: 85px;
    top: 2px;
}

.scale-top::before {
    content: "";

    position: absolute;

    width: 5px;
    height: 18px;

    background: #1a1a1a;

    left: 2.5px;
    top: 7px;
}

.scale-ball {
    position: absolute;

    width: 4px;
    height: 4px;

    background: #ffffff;

    border-radius: 50%;

    left: 3px;
    top: 3px;
}



/* Main column */
.scale-column {
    position: absolute;

    width: 7px;
    height: 132px;

    background: linear-gradient(
        to right,
        #222222,
        #666666,
        #1b1b1b
    );

    left: 86px;
    top: 20px;

    border-radius: 5px;
}

.scale-column::before {
    content: "";

    position: absolute;

    width: 17px;
    height: 18px;

    background: #252525;

    border-radius: 50% 50% 35% 35%;

    left: -5px;
    top: 12px;
}



/* Scale base */
.scale-base {
    position: absolute;

    width: 68px;
    height: 13px;

    background: #222222;

    left: 55px;
    bottom: 29px;

    border-radius: 3px;
}

.scale-base-middle {
    position: absolute;

    width: 88px;
    height: 10px;

    background: #555555;

    left: 45px;
    bottom: 20px;

    border-radius: 2px;
}

.scale-platform {
    position: absolute;

    width: 105px;
    height: 8px;

    background: #222222;

    left: 36px;
    bottom: 12px;

    border-radius: 3px;
}



/* Scale arms */
.scale-arm {
    position: absolute;

    width: 92px;
    height: 40px;

    top: 35px;
}

.left-arm {
    left: 1px;
}

.right-arm {
    right: 1px;
}

.arm-line {
    position: absolute;

    width: 91px;
    height: 4px;

    background: #222222;

    border-radius: 50%;

    top: 0;
}

.left-arm .arm-line {
    transform: rotate(8deg);
}

.right-arm .arm-line {
    transform: rotate(-8deg);
}



/* Scale strings */
.scale-string {
    position: absolute;

    width: 1px;
    height: 44px;

    background: #333333;

    top: 5px;
}

.left-string {
    left: 9px;
}

.right-string {
    right: 9px;
}



/* Scale pans */
.scale-pan {
    position: absolute;

    width: 47px;
    height: 10px;

    border-radius: 0 0 50% 50%;

    border-bottom: 4px solid #222222;

    top: 45px;
}

.left-pan {
    left: -14px;
}

.right-pan {
    right: -14px;
}



/* =========================================
   GAVEL
========================================= */

.gavel {
    position: absolute;

    width: 110px;
    height: 85px;

    left: 27px;
    bottom: 29px;

    transform: rotate(22deg);
}

.gavel-head {
    position: absolute;

    width: 48px;
    height: 21px;

    background: linear-gradient(
        to bottom,
        #111111,
        #454545,
        #111111
    );

    border-radius: 10px;

    left: 5px;
    top: 7px;
}

.gavel-head::before,
.gavel-head::after {
    content: "";

    position: absolute;

    width: 8px;
    height: 28px;

    background: #222222;

    border-radius: 4px;

    top: -3px;
}

.gavel-head::before {
    left: -4px;
}

.gavel-head::after {
    right: -4px;
}

.gavel-neck {
    position: absolute;

    width: 15px;
    height: 13px;

    background: #292929;

    left: 47px;
    top: 11px;
}

.gavel-handle {
    position: absolute;

    width: 69px;
    height: 10px;

    background: linear-gradient(
        to bottom,
        #222222,
        #777777,
        #222222
    );

    border-radius: 7px;

    left: 49px;
    top: 13px;

    transform: rotate(1deg);
}



/* =========================================
   LAPTOP
========================================= */

.laptop {
    position: absolute;

    width: 235px;
    height: 180px;

    right: 53px;
    bottom: 29px;

    transform: perspective(700px) rotateY(-5deg);
}



/* Laptop screen */
.laptop-screen {
    position: absolute;

    width: 177px;
    height: 128px;

    right: 17px;
    top: 0;

    background: #111111;

    border: 6px solid #292929;

    border-radius: 7px 7px 3px 3px;

    transform: skew(-8deg);

    box-shadow: 0 3px 8px rgba(0, 0, 0, 0.2);
}



/* Screen */
.screen-content {
    width: 100%;
    height: 100%;

    position: relative;

    background:
        radial-gradient(
            circle at center,
            #303030 0,
            #171717 45%,
            #090909 100%
        );

    overflow: hidden;
}



/* AI chip */
.ai-chip {
    position: absolute;

    width: 54px;
    height: 54px;

    left: 57px;
    top: 34px;

    border: 2px solid #dddddd;

    background: #181818;

    display: flex;
    align-items: center;
    justify-content: center;
}

.chip-text {
    color: #ffffff;

    font-size: 22px;
    font-weight: 700;

    letter-spacing: -1px;
}

.ai-chip::before,
.ai-chip::after {
    content: "";

    position: absolute;

    width: 8px;
    height: 8px;

    border: 1px solid #dddddd;
}

.ai-chip::before {
    top: -6px;
    left: 9px;

    border-bottom: none;
}

.ai-chip::after {
    bottom: -6px;
    right: 9px;

    border-top: none;
}



/* Chip lines */
.chip-line {
    position: absolute;

    display: block;

    background: #cccccc;
}

.chip-line-top {
    width: 2px;
    height: 9px;

    top: -10px;
    left: 25px;
}

.chip-line-bottom {
    width: 2px;
    height: 9px;

    bottom: -10px;
    right: 25px;
}

.chip-line-left {
    width: 9px;
    height: 2px;

    left: -10px;
    top: 25px;
}

.chip-line-right {
    width: 9px;
    height: 2px;

    right: -10px;
    bottom: 25px;
}



/* Circuit decoration */
.circuit {
    position: absolute;

    height: 1px;

    background: #777777;

    opacity: 0.65;
}

.circuit-one {
    width: 36px;

    left: 19px;
    top: 43px;
}

.circuit-two {
    width: 29px;

    right: 18px;
    top: 59px;
}

.circuit-three {
    width: 41px;

    left: 19px;
    bottom: 35px;
}



/* Laptop base */
.laptop-base {
    position: absolute;

    width: 228px;
    height: 16px;

    right: 0;
    bottom: 24px;

    background: linear-gradient(
        to bottom,
        #bcbcbc,
        #eeeeee,
        #9c9c9c
    );

    clip-path: polygon(
        8% 0,
        92% 0,
        100% 70%,
        94% 100%,
        3% 100%,
        0 70%
    );

    border-radius: 2px;
}



/* Laptop trackpad */
.laptop-trackpad {
    position: absolute;

    width: 49px;
    height: 6px;

    right: 88px;
    bottom: 28px;

    border: 1px solid #999999;

    border-radius: 2px;
}



/* =========================================
   RESPONSIVE DESIGN
========================================= */

@media (max-width: 1100px) {

    .main-navigation {
        gap: 17px;
        margin-right: 20px;
    }

    .main-navigation a {
        font-size: 10px;
    }

    .header-container {
        padding: 0 25px;
    }

    .hero-container {
        padding-left: 35px;
        padding-right: 35px;
    }

    .hero-content h1 {
        font-size: 30px;
    }

    .hero-visual {
        transform: scale(0.9);
        transform-origin: center;
    }

}



@media (max-width: 850px) {

    .site-header {
        height: auto;
    }

    .header-container {
        padding: 17px 25px;

        flex-wrap: wrap;

        gap: 15px;
    }

    .main-navigation {
        order: 3;

        width: 100%;

        justify-content: center;

        margin: 0;

        overflow-x: auto;

        padding-bottom: 3px;
    }

    .hero-container {
        grid-template-columns: 1fr;

        padding-top: 45px;

        text-align: center;
    }

    .hero-content {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .hero-description {
        max-width: 450px;
    }

    .hero-visual {
        margin-top: 20px;

        transform: scale(0.9);
    }

    .hero-trust {
        justify-content: center;
    }

}



@media (max-width: 560px) {

    .header-container {
        padding: 15px 18px;
    }

    .brand-name {
        font-size: 13px;
    }

    .header-button {
        height: 32px;

        padding: 0 13px;

        font-size: 10px;
    }

    .main-navigation {
        gap: 18px;
        justify-content: flex-start;
    }

    .hero-container {
        padding: 38px 18px 25px;
    }

    .hero-content h1 {
        font-size: 29px;
        letter-spacing: -1px;
    }

    .hero-description {
        font-size: 11px;
    }

    .hero-visual {
        height: 300px;

        transform: scale(0.72);

        margin-top: -5px;

        margin-left: -12%;
        margin-right: -12%;
    }

}
/* =========================================
   PART 2
   PROBLEM + AI TECHNOLOGY
========================================= */

.technology-section {
    width: 100%;

    background: #ffffff;

    padding: 0 34px 25px;
}

.technology-container {
    width: 100%;
    max-width: 1310px;

    margin: 0 auto;

    display: grid;

    grid-template-columns: 31% 69%;

    gap: 14px;

    align-items: stretch;
}



/* =========================================
   LEFT : PROBLEM CARD
========================================= */

.problem-card {
    border: 1px solid #e5e5e5;

    border-radius: 6px;

    background: #ffffff;

    padding: 17px 15px 15px;

    display: flex;

    flex-direction: column;

    justify-content: space-between;

    min-height: 275px;
}

.problem-content h2 {
    font-size: 18px;

    line-height: 1.2;

    letter-spacing: -0.5px;

    font-weight: 700;

    margin-bottom: 16px;
}



/* Problem list */

.problem-list {
    list-style: none;

    display: flex;

    flex-direction: column;

    gap: 9px;
}

.problem-list li {
    display: flex;

    align-items: center;

    gap: 8px;

    font-size: 9.5px;

    line-height: 1.35;

    color: #333333;
}

.check-icon {
    width: 12px;
    height: 12px;

    min-width: 12px;

    border: 1px solid #555555;

    border-radius: 50%;

    display: flex;

    align-items: center;

    justify-content: center;

    font-size: 7px;

    font-weight: 700;

    color: #222222;
}



/* =========================================
   PROBLEM MESSAGE
========================================= */

.problem-message {
    width: 100%;

    min-height: 62px;

    background: #202020;

    border-radius: 5px;

    margin-top: 17px;

    padding: 10px 12px;

    display: flex;

    align-items: center;

    gap: 11px;

    color: #ffffff;
}

.message-icon {
    width: 30px;

    min-width: 30px;

    display: flex;

    justify-content: center;

    align-items: center;
}



/* Light bulb */

.bulb {
    position: relative;

    width: 20px;
    height: 23px;

    border: 1.5px solid #ffffff;

    border-radius: 50% 50% 45% 45%;

    opacity: 0.9;
}

.bulb::before {
    content: "";

    position: absolute;

    width: 8px;
    height: 5px;

    border-bottom: 1.5px solid #ffffff;

    left: 4px;

    bottom: -5px;
}

.bulb::after {
    content: "";

    position: absolute;

    width: 2px;
    height: 5px;

    background: #ffffff;

    left: 8px;

    top: -6px;
}

.bulb span::before,
.bulb span::after {
    content: "";

    position: absolute;

    width: 5px;
    height: 1px;

    background: #ffffff;

    top: 5px;
}

.bulb span::before {
    left: -7px;

    transform: rotate(-30deg);
}

.bulb span::after {
    right: -7px;

    transform: rotate(30deg);
}



.problem-message p {
    font-size: 8.5px;

    line-height: 1.5;

    color: #ffffff;
}



/* =========================================
   RIGHT : AI TECHNOLOGY CARD
========================================= */

.ai-technology-card {
    border: 1px solid #e5e5e5;

    border-radius: 6px;

    background: #ffffff;

    padding: 16px 15px 10px;

    min-height: 275px;
}



/* Heading */

.technology-heading h2 {
    font-size: 18px;

    line-height: 1.2;

    letter-spacing: -0.45px;

    font-weight: 700;

    margin-bottom: 5px;
}

.technology-heading p {
    max-width: 620px;

    font-size: 9.5px;

    line-height: 1.5;

    color: #444444;

    margin-bottom: 12px;
}



/* =========================================
   FEATURE CARDS
========================================= */

.feature-cards {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 9px;
}

.feature-card {
    min-height: 165px;

    border: 1px solid #e8e8e8;

    border-radius: 5px;

    padding: 12px;

    background: #ffffff;
}



/* =========================================
   FEATURE ICONS
========================================= */

.feature-icon {
    width: 42px;
    height: 42px;

    margin-bottom: 6px;

    position: relative;

    display: flex;

    align-items: center;

    justify-content: center;
}



/* =========================================
   INTELLIGENT ASSISTANCE ICON
========================================= */

.brain-circle {
    position: relative;

    width: 27px;
    height: 32px;

    border: 1.5px solid #333333;

    border-radius: 48% 48% 45% 45%;
}

.brain-circle::before {
    content: "";

    position: absolute;

    width: 2px;
    height: 23px;

    background: #333333;

    left: 12px;

    top: 4px;
}

.brain-circle::after {
    content: "";

    position: absolute;

    width: 8px;
    height: 8px;

    border-left: 1.5px solid #333333;
    border-bottom: 1.5px solid #333333;

    left: -5px;
    top: 10px;

    transform: rotate(45deg);
}

.brain-line {
    position: absolute;

    width: 6px;
    height: 6px;

    border: 1px solid #333333;

    border-radius: 50%;

    background: #ffffff;
}

.line-a {
    left: -5px;
    top: 3px;
}

.line-b {
    right: -5px;
    top: 7px;
}

.line-c {
    left: -5px;
    bottom: 5px;
}

.line-d {
    right: -5px;
    bottom: 3px;
}



/* =========================================
   DOCUMENT INTELLIGENCE ICON
========================================= */

.document-symbol {
    position: relative;

    width: 25px;
    height: 31px;

    border: 1.5px solid #333333;

    border-radius: 2px;
}

.document-fold {
    position: absolute;

    width: 8px;
    height: 8px;

    right: -1px;
    top: -1px;

    border-left: 1.5px solid #333333;
    border-bottom: 1.5px solid #333333;

    background: #ffffff;
}

.document-line {
